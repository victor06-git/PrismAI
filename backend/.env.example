# OpenAI API key — used for /api/process-meeting (gpt-4o-mini, Structured Outputs)
OPENAI_API_KEY=sk-...

# Fal.ai API key — used for /api/generate-asset (fal-ai/flux/schnell)
FAL_KEY=...

# Cala API key — used for /api/data-insights ("Skip the Data" analytics)
CALA_API_KEY=...

# Optional: override Cala's API base URL (defaults to a placeholder — Cala's
# real REST contract wasn't available for this build, swap in the real one).
# CALA_API_BASE_URL=https://api.cala.example.com/v1

# Optional: set to "false" to disable the automatic mock-data fallback and
# get real HTTPException(500/502) responses when an upstream call fails.
# Defaults to "true" (recommended during the live demo).
# ENABLE_MOCK_FALLBACK=true
