# OpenAI API key — used for /api/process-meeting (gpt-4o-mini, Structured Outputs)
OPENAI_API_KEY=sk-...

# Fal.ai API key — used for /api/generate-asset (fal-ai/flux/schnell)
FAL_KEY=...

# Cala API key — used for /api/data-insights ("Skip the Data" analytics)
CALA_API_KEY=...

# Optional: override Cala's API base URL. Defaults to https://api.cala.ai/v1.
# CALA_API_BASE_URL=https://api.cala.ai/v1

# No mock-data fallback flag: every endpoint calls the real API and raises a
# real HTTPException (500/502) if it fails. Set all three keys above before
# a live demo — there is no canned-data safety net.

# JWT signing secret for the QR-based auth flow (/api/auth/*).
# If unset, a random ephemeral secret is generated at startup (fine for a
# demo, but tokens won't validate after a restart or across multiple workers).
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Optional: override auth timing (units as shown).
# JWT_EXPIRE_MINUTES=60
# QR_SESSION_TTL_SECONDS=300

# Optional: comma-separated CORS allowlist. Defaults to the local Next.js dev
# origins (http://localhost:3000, http://127.0.0.1:3000) when unset — never
# falls back to "*". Set this to your real frontend origin(s) in production.
# ALLOWED_ORIGINS=https://app.prismai.example.com,https://prismai.example.com
